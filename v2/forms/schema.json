  "rs-cares-volunteer": {
    "title": "Rocket Station Cares — Volunteer Sign-Up",
    "group": "Community",
    "description": "This form collects the information needed to coordinate future volunteer initiatives while keeping signup simple.",
    "fields": [
      {
        "label": "1. Full Name",
        "type": "text",
        "required": true,
        "options": []
      },
      {
        "label": "2. Mobile Number",
        "type": "text",
        "required": true,
        "options": []
      },
      {
        "label": "3. Current City / Municipality & Province",
        "type": "text",
        "required": true,
        "options": []
      },
      {
        "label": "4. Are you willing to travel for volunteer activities?",
        "type": "radio",
        "required": true,
        "options": [
          "Only within my city/municipality",
          "Anywhere within my province",
          "Nearby provinces",
          "Anywhere in the Philippines (when feasible)"
        ]
      },
      {
        "label": "5. Which Rocket Station Cares activities are you interested in? (Select all that apply)",
        "type": "checkbox",
        "required": true,
        "options": [
          "Community Outreach",
          "Education / School Programs",
          "Feeding Programs",
          "Environmental Activities (Tree Planting, Clean-up Drives, etc.)",
          "Disaster Relief",
          "Medical Missions",
          "Animal Welfare",
          "Senior Citizen Programs",
          "Children’s Programs",
          "Fundraising Activities",
          ""
        ]
      },
      {
        "label": "6. How would you like to contribute? (Select all that apply)",
        "type": "checkbox",
        "required": true,
        "options": [
          "Volunteer during events",
          "Help organize events",
          "Assist with logistics",
          "Photography / Videography",
          "Social Media / Content Creation",
          "Administrative Support",
          "Donate supplies when needed",
          "Offer professional skills",
          "I’m open to helping wherever needed"
        ]
      },
      {
        "label": "7. Skills or Certifications (Optional)",
        "type": "textarea",
        "required": false,
        "options": []
      },
      {
        "label": "8. Are you interested in helping lead or coordinate future Rocket Station Cares activities? (Optional)",
        "type": "radio",
        "required": false,
        "options": [
          "Yes",
          "Maybe in the future",
          "Not at this time"
        ]
      },
      {
        "label": "9. How often would you like to volunteer?",
        "type": "radio",
        "required": true,
        "options": [
          "Whenever I’m available",
          "Once every few months",
          "During major Rocket Station Cares events only",
          "I’ll decide on a case-by-case basis"
        ]
      },
      {
        "label": "10. Physical Limitations or Accessibility Needs (Optional)",
        "type": "textarea",
        "required": false,
        "options": []
      },
      {
        "label": "11. Additional Information (Optional)",
        "type": "textarea",
        "required": false,
        "options": []
      },
      {
        "label": "12. Volunteer Consent",
        "type": "checkbox",
        "required": true,
        "options": [
          "I understand that submitting this form expresses my interest in volunteering for Rocket Station Cares. Participation in future activities is completely voluntary, and I may choose whether or not to join each opportunity as opportunities become available."
        ]
      }
    ]
  },
